0 -14 Td (4. Wait 1 sec) Tj
0 -14 Td (5. Tap Invited me tab) Tj
0 -14 Td (6. Wait 1 sec) Tj
0 -14 Td (7. Tap input box \("Please enter the order code"\)) Tj
0 -14 Td (8. Type %latest_code) Tj
0 -14 Td (9. Wait 300 ms) Tj
0 -14 Td (10. Tap Confirm) Tj
0 -14 Td (11. Wait 2 sec) Tj
0 -14 Td (12. Open tab switcher and close current tab \(memory cleanup\)) Tj
0 -14 Td () Tj
